# Copy this file to `.env.local` and fill in your Supabase service-role key.
#
#   copy .env.example .env.local
#
# NEVER commit `.env.local` — it contains a service-role key with admin access
# to your Supabase project. The `.gitignore` already excludes it.
#
# You can find this key in: Supabase Dashboard → Project Settings → API → 
# "service_role" (Secret). It is only used by `npm run deploy` to upload
# dist/bundle.js to the public Storage bucket the bookmarklet loads from.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
